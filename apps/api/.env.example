# Banquet.ai API settings. In AWS these come from the ECS task definition and Secrets Manager
# (see infra/aws). Values marked "secret" must never be committed.

NODE_ENV=production
PORT=3000
# secret: MongoDB Atlas connection string (mongodb+srv://user:pass@cluster/banquetai?retryWrites=true&w=majority)
MONGO_URL=
# secret: random, at least 32 characters (openssl rand -base64 48). Changing it logs everyone out.
JWT_SECRET=
# secret: random, at least 32 characters. Used by Banquet.ai's own admin endpoints until the admin console has logins.
PLATFORM_ADMIN_TOKEN=
BASE_DOMAIN=banquet.ai
# No domain yet: every client shares this one address and types their Domain at login (leave empty once a domain is set).
SINGLE_HOST=
# aws: SMS through SNS and email through SES. "console" only for development (it logs passwords and codes).
NOTIFY_PROVIDER=aws
AWS_REGION=ap-south-1
MAIL_FROM=no-reply@banquet.ai
# CloudFront and the load balancer sit in front of the API.
TRUST_PROXY=2
# Lets the X-Tenant header choose the tenant. On by default with SINGLE_HOST, off otherwise in production.
# ALLOW_TENANT_HEADER=false
# Leave empty: the web app and API share a host.
CORS_ORIGINS=
